{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "StructuredOutput"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(terraform apply:*)",
      "Bash(tofu apply:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" || exit 2",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
