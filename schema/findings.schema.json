{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/H-Nizami/claude-infra-review/schema/findings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "risk_level",
    "findings",
    "dropped_scanner_findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "risk_level": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "line_start",
          "line_end",
          "severity",
          "category",
          "source",
          "rule_id",
          "title",
          "why_it_matters",
          "suggested_fix",
          "confidence"
        ],
        "properties": {
          "file": {
            "type": "string",
            "maxLength": 300
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "category": {
            "enum": [
              "public_exposure",
              "network_open",
              "iam_wildcard",
              "iam_widening",
              "privileged_container",
              "host_access",
              "missing_limits",
              "destroy_protection",
              "stateful_replace",
              "hardcoded_secret",
              "data_residency",
              "cost_jump",
              "encryption",
              "prompt_injection",
              "other"
            ]
          },
          "source": {
            "enum": [
              "scanner",
              "claude",
              "both"
            ]
          },
          "rule_id": {
            "type": "string",
            "description": "scanner rule id, or 'semantic'",
            "maxLength": 300
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "why_it_matters": {
            "type": "string",
            "maxLength": 600
          },
          "suggested_fix": {
            "type": "string",
            "maxLength": 800
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "dropped_scanner_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "rule_id",
          "file",
          "reason"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 300
          },
          "rule_id": {
            "type": "string",
            "maxLength": 300
          },
          "file": {
            "type": "string",
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "maxItems": 100
    }
  }
}
